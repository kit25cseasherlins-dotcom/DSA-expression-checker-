import java.util.Scanner;
import java.util.Stack;
public class miniproject {
    public static boolean isBalanced(String expression) {
        Stack<Character> stack = new Stack<>();
        for (int i = 0; i < expression.length(); i++) {
            char ch = expression.charAt(i);
            if (ch == '(' || ch == '{' || ch == '[') {
                stack.push(ch);
            }
            else if (ch == ')' || ch == '}' || ch == ']') {
                if (stack.isEmpty()) return false;
               char top = stack.pop();
                if ((ch == ')' && top != '(') ||
                    (ch == '}' && top != '{') ||
                    (ch == ']' && top != '[')) {
                    return false;
                }
            }
        }
        return stack.isEmpty();
    }
    public static void main(String[] args) {
        Scanner lin = new Scanner(System.in);
        System.out.println("====================================");
        System.out.println("   CODE QUALITY GUARD (IDE SYSTEM)  ");
        System.out.println("====================================");
        System.out.println("NAME   : Sherlin S");
        System.out.println("REG.NO : 711525BCS157");
        System.out.println("DEPT   : CSE_A");
        System.out.println("------------------------------------");
        System.out.print("Enter Expression: ");
        String expr = lin.nextLine();
        if (expr.trim().isEmpty()) {
            System.out.println(" Error: No input given!");
            return;
        }
        if (isBalanced(expr))
            System.out.println(" Balanced Expression");
        else
            System.out.println(" Unbalanced Expression");
        lin.close();
    }
}
